# =============================================================================
# Skilld Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and update values for your local environment
# All NEXT_PUBLIC_* variables are exposed to the browser
# See src/lib/env.ts for validation rules

# -----------------------------------------------------------------------------
# API Configuration (Required)
# -----------------------------------------------------------------------------

# Base URL for the backend API
# Used for all HTTP requests to the Skilld backend service
# Must be a valid URL with protocol (http:// or https://)
# Development: https://localhost:5001
# Production: https://api.skilld.com
NEXT_PUBLIC_API_BASE_URL=https://localhost:5001

# SignalR WebSocket Hub URL
# Used for real-time communication (chat, notifications, booking updates)
# Must be a valid URL pointing to the SignalR hub endpoint
# Typically: {API_BASE_URL}/hubs/realtime
NEXT_PUBLIC_SIGNALR_HUB_URL=https://localhost:5001/hubs/realtime

# -----------------------------------------------------------------------------
# Third-Party Services (Optional)
# -----------------------------------------------------------------------------

# Maps Provider API Key
# Used for displaying worker locations and service area maps
# Leave empty to disable map features
# Supported providers: Google Maps, Mapbox (configure in map component)
NEXT_PUBLIC_MAPS_PROVIDER_KEY=

# -----------------------------------------------------------------------------
# Localization (Optional)
# -----------------------------------------------------------------------------

# Default application locale/language
# Used as fallback when user preference is not set
# Supported values: en, es, fr, de (configure in i18n config)
# Default: en
NEXT_PUBLIC_DEFAULT_LOCALE=en
